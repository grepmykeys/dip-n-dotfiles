# Wallpaper-driven Matugen palette
theme = "matugen"
link-previews = true

# Shell integration
shell-integration = zsh
shell-integration-features = no-cursor, sudo

# Custom Shaders
# custom-shader = shaders/sonic_boom_cursor.glsl
custom-shader = shaders/cursor_tail.glsl

# Font Configuration
font-family = "CaskaydiaCove Nerd Font"
font-family = "icons-in-terminal"
font-family = "CaskaydiaCove Nerd Font Mono"
font-size = 12
font-thicken = false
font-feature = "liga, calt"
adjust-cell-height = 12%
adjust-icon-height = 12%

# Window Configuration
window-decoration = true
window-padding-x = 15
window-padding-y = 4
background-opacity = 0.9
background-blur = false
window-inherit-font-size = true
window-theme = ghostty
# window-padding-color = background

# Cursor Configuration
cursor-style = bar
cursor-style-blink = true

# Scrollback
scrollback-limit = 8000

# Terminal features
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false

# Disable in-app Ghostty toast notifications
app-notifications = false

# Key bindings for common actions
# keybind = ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Material 3 UI elements
# unfocused-split-opacity = 0.62
# unfocused-split-fill = #44464f

# Tab configuration
gtk-titlebar = false

# Rando stuff
# gtk-single-instance = true
link-previews = true

